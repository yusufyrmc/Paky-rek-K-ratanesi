# Pakyürek Kıraathanesi - Supabase Bulut Veritabanı Yapılandırması
# https://supabase.com adresinden projenizi açıp Settings -> API bölümünden aşağıdaki bilgileri alabilirsiniz:

PORT=3000

# Supabase Proje URL'niz (Örn: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase Anon / Public API Key veya Service Role Key'iniz
SUPABASE_KEY=
